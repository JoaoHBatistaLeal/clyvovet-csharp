# Configuracoes de Ambiente - ByteCare (CLYVO VET)
ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# Banco de Dados PostgreSQL (Local ou Nuvem ACI)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=db_bytecare;Username=postgres;Password=SEU_PASSWORD_AQUI
# Para desenvolvimento local isolado sem PostgreSQL, defina UseSqlite como true:
Database__UseSqlite=true

# Segredo de Assinatura JWT (Minimo 32 caracteres / 256 bits)
JWT_SECRET=SEU_JWT_SECRET_COM_PELO_MENOS_32_CARACTERES_AQUI

# Credenciais Administrativas de Autenticacao
AUTH_USERNAME=admin
AUTH_PASSWORD=SUA_SENHA_ADMINISTRATIVA_SEGURA_AQUI

# Azure Key Vault (Opcional para integracao em nuvem)
KEY_VAULT_NAME=
KEY_VAULT_URI=
